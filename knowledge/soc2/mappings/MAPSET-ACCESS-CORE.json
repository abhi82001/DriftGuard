{
  "$schema": "../schemas/mapping.schema.json",
  "record_type": "mapping_set",
  "mapping_set_id": "MAPSET-ACCESS-CORE",
  "name": "Access Management and Vulnerability Management Core Relationship Set",
  "description": "Authoritative relationship graph for the foundation exemplar records. Entity files carry convenience references for readability; this set is what DriftGuard traverses, and it is the reference against which those convenience fields are validated for consistency.",
  "relationship_model": {
    "chain": ["criterion", "control", "evidence", "policy", "questionnaire", "finding", "remediation"],
    "traversal_notes": [
      "The chain is a conceptual ordering, not a strict hierarchy. Every edge is traversable in both directions via its declared inverse.",
      "Control-to-evidence and control-to-criterion are many-to-many. One artifact can support several controls and one criterion is typically met by several controls.",
      "Findings attach to criteria as well as controls, so a gap can be reported even where the organization has no named control at all.",
      "Questions attach to controls and criteria so that a questionnaire answer can raise a finding without any evidence having been submitted."
    ]
  },
  "relationship_types": [
    { "type": "addresses_criterion", "from_entity": "control", "to_entity": "criterion", "inverse": "criterion_addressed_by", "cardinality": "many_to_many", "answers_question": "Which controls address this criterion?" },
    { "type": "supported_by_evidence", "from_entity": "control", "to_entity": "evidence", "inverse": "supports_control", "cardinality": "many_to_many", "answers_question": "Which evidence supports this control, and which controls does this evidence support?" },
    { "type": "documented_by_policy", "from_entity": "control", "to_entity": "policy", "inverse": "documents_control", "cardinality": "many_to_many", "answers_question": "Which policies support this control?" },
    { "type": "assessed_by_question", "from_entity": "control", "to_entity": "question", "inverse": "assesses_control", "cardinality": "many_to_many", "answers_question": "Which questionnaire questions relate to this control?" },
    { "type": "indicates_finding", "from_entity": "evidence", "to_entity": "finding", "inverse": "detected_by_evidence", "cardinality": "many_to_many", "answers_question": "What findings can this evidence reveal?" },
    { "type": "question_indicates_finding", "from_entity": "question", "to_entity": "finding", "inverse": "indicated_by_question", "cardinality": "many_to_many", "answers_question": "Which answers signal a potential gap?" },
    { "type": "finding_affects_control", "from_entity": "finding", "to_entity": "control", "inverse": "control_affected_by_finding", "cardinality": "many_to_many", "answers_question": "What findings can indicate a gap in this control?" },
    { "type": "finding_affects_criterion", "from_entity": "finding", "to_entity": "criterion", "inverse": "criterion_affected_by_finding", "cardinality": "many_to_many", "answers_question": "Which criteria are at risk from this finding?" },
    { "type": "remediated_by", "from_entity": "finding", "to_entity": "remediation", "inverse": "remediates", "cardinality": "many_to_many", "answers_question": "What remediation addresses this finding?" },
    { "type": "verified_by_evidence", "from_entity": "remediation", "to_entity": "evidence", "inverse": "verifies_remediation", "cardinality": "many_to_many", "answers_question": "How do we confirm the remediation actually landed?" }
  ],
