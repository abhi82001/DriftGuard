{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftguard.io/schemas/soc2/finding.schema.json",
  "title": "DriftGuard SOC 2 Finding Archetype",
  "description": "A reusable pattern of what commonly goes wrong. This is an ARCHETYPE in the knowledge base, not an audit finding about a specific customer. Only a service auditor issues findings; DriftGuard produces observations against these archetypes.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "finding"
    },
    "finding_id": {
      "$ref": "common.defs.json#/$defs/finding_id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "finding_category": {
      "type": "string",
      "enum": [
        "control_absent",
        "design_deficiency",
        "operating_deficiency",
        "evidence_deficiency",
        "documentation_deficiency",
        "scope_deficiency",
        "timeliness_deficiency",
        "third_party_deficiency"
      ]
    },
    "observation_class": {
      "type": "string",
      "enum": [
        "missing_evidence",
        "insufficient_evidence",
        "control_design_gap",
        "control_operating_gap",
        "potentially_ineffective_control",
        "informational_observation"
      ],
      "description": "How strong a conclusion the available information supports. Distinct from finding_category, which describes the nature of the deficiency. The absence of an artifact is missing_evidence, NOT a control gap: DriftGuard may only assert a design or operating gap when the evidence supports that conclusion."
    },
    "conclusion_rules": {
      "type": "object",
      "description": "What DriftGuard is and is not permitted to assert for this archetype, and what would justify a stronger conclusion.",
      "properties": {
        "may_assert": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "must_not_assert": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "escalates_to": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "observation_class": {
                "type": "string",
                "enum": [
                  "missing_evidence",
                  "insufficient_evidence",
                  "control_design_gap",
                  "control_operating_gap",
                  "potentially_ineffective_control",
                  "informational_observation"
                ]
              },
              "when": {
                "type": "string"
              }
            },
            "required": [
              "observation_class",
              "when"
            ],
            "additionalProperties": false
          }
        },
        "de_escalates_to": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "observation_class": {
                "type": "string",
                "enum": [
                  "missing_evidence",
                  "insufficient_evidence",
                  "control_design_gap",
                  "control_operating_gap",
                  "potentially_ineffective_control",
                  "informational_observation"
                ]
              },
              "when": {
                "type": "string"
              }
            },
            "required": [
              "observation_class",
              "when"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "may_assert",
        "must_not_assert"
      ],
      "additionalProperties": false
    },
    "affected_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.defs.json#/$defs/criterion_id"
      },
      "uniqueItems": true
    },
    "affected_controls": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/control_id"
      },
      "uniqueItems": true
    },
    "default_severity": {
      "$ref": "common.defs.json#/$defs/severity"
    },
    "severity_factors": {
      "type": "object",
      "description": "Inputs that adjust severity, mirroring auditor judgement (see framework/common_findings.md).",
      "properties": {
        "criterion_impact": {
          "type": "string"
        },
        "pervasiveness": {
          "type": "string"
        },
        "compensating_controls": {
          "type": "array",
          "items": {
            "$ref": "common.defs.json#/$defs/control_id"
          }
        },
        "detectability": {
          "type": "string"
        },
        "escalates_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "de_escalates_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "detection_signals": {
      "type": "array",
      "minItems": 1,
      "description": "Observable conditions that indicate this archetype. The input to DriftGuard gap detection.",
      "items": {
        "type": "object",
        "properties": {
          "signal_id": {
            "type": "string",
            "pattern": "^SIG-[0-9]{3}$"
          },
          "signal": {
            "type": "string"
          },
          "source_of_signal": {
            "type": "string",
            "enum": [
              "evidence_analysis",
              "questionnaire_answer",
              "report_parsing",
              "policy_analysis",
              "human_input"
            ]
          },
          "related_evidence": {
            "type": "array",
            "items": {
              "$ref": "common.defs.json#/$defs/evidence_id"
            }
          },
          "related_question": {
            "$ref": "common.defs.json#/$defs/question_id"
          },
          "confidence": {
            "$ref": "common.defs.json#/$defs/confidence"
          }
        },
        "required": [
          "signal_id",
          "signal",
          "source_of_signal"
        ],
        "additionalProperties": false
      }
    },
    "auditor_impact": {
      "type": "string",
      "description": "How a service auditor would likely treat this. Tier 4; must be hedged."
    },
    "customer_impact": {
      "type": "string",
      "description": "Why a user entity reviewing the vendor should care."
    },
    "remediations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.defs.json#/$defs/remediation_id"
      },
      "uniqueItems": true
    },
    "false_positive_guidance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Conditions under which this signal is NOT a gap. Required to avoid over-reporting."
    },
    "sources": {
      "$ref": "common.defs.json#/$defs/source_id_list"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/source_ref"
      }
    },
    "authority_tier_dominant": {
      "$ref": "common.defs.json#/$defs/authority_tier"
    },
    "verification_status": {
      "$ref": "common.defs.json#/$defs/verification_status"
    },
    "version": {
      "$ref": "common.defs.json#/$defs/semver"
    },
    "schema_version": {
      "$ref": "common.defs.json#/$defs/semver"
    },
    "status": {
      "$ref": "common.defs.json#/$defs/record_status"
    },
    "created": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "last_reviewed": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "superseded_by": {
      "$ref": "common.defs.json#/$defs/finding_id"
    },
    "notes": {
      "$ref": "common.defs.json#/$defs/notes"
    }
  },
  "required": [
    "record_type",
    "finding_id",
    "name",
    "description",
    "finding_category",
    "observation_class",
    "conclusion_rules",
    "affected_criteria",
    "default_severity",
    "detection_signals",
    "remediations",
    "false_positive_guidance",
    "sources",
    "authority_tier_dominant",
    "verification_status",
    "version",
    "schema_version",
    "status",
    "created",
    "last_reviewed"
  ],
  "additionalProperties": false,
  "x-driftguard-schema-version": "0.2.0"
}
