{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftguard.io/schemas/soc2/evidence.schema.json",
  "title": "DriftGuard SOC 2 Evidence Definition",
  "description": "Defines a TYPE of evidence (the template), not a customer's uploaded artifact (the instance). Instances are runtime data and are validated against the validation_rules declared here.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "evidence"
    },
    "evidence_id": {
      "$ref": "common.defs.json#/$defs/evidence_id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "configuration_export",
        "system_generated_report",
        "log_extract",
        "ticket_record",
        "signed_document",
        "policy_document",
        "screenshot",
        "attestation",
        "scan_result",
        "training_record",
        "contract",
        "third_party_report",
        "meeting_record",
        "code_artifact"
      ]
    },
    "evidence_role": {
      "type": "string",
      "enum": [
        "configuration",
        "operational",
        "approval",
        "review",
        "design_documentation",
        "third_party_assurance"
      ],
      "description": "The role the artifact plays in an assessment, independent of its file form. configuration = declared state of a system; operational = record of the control running; approval = record of an authorisation decision; review = record of a periodic assessment; design_documentation = how the control is intended to work; third_party_assurance = an external party's report about controls DriftGuard cannot observe."
    },
    "origin": {
      "type": "string",
      "enum": [
        "system_generated",
        "human_generated",
        "hybrid"
      ],
      "description": "Who or what produced the content. system_generated artifacts are reproducible independently of the person supplying them and carry more weight; human_generated artifacts assert rather than demonstrate. hybrid means a system record whose substance is a human decision, such as an approval ticket."
    },
    "collection_mode": {
      "type": "string",
      "enum": [
        "automated_api",
        "automated_export",
        "manual_export",
        "manual_capture",
        "narrative"
      ]
    },
    "persuasiveness_tier": {
      "type": "string",
      "enum": [
        "strong",
        "moderate",
        "weak"
      ],
      "description": "Practitioner-weighted strength. Tier 4 interpretation; must never be presented as an audit rule."
    },
    "period_coverage": {
      "type": "string",
      "enum": [
        "point_in_time",
        "period",
        "either"
      ],
      "description": "Whether the artifact evidences state at a moment or operation across a period. point_in_time evidence alone does not support a Type 2 conclusion."
    },
    "type2_pairing_requirement": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/evidence_id"
      },
      "description": "For point_in_time evidence: companion evidence needed to demonstrate the state persisted through the period."
    },
    "expected_content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "why": {
            "type": "string",
            "description": "What conclusion this element enables. Prevents cargo-cult evidence requests."
          }
        },
        "required": [
          "element",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "applicable_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "control_id": {
            "$ref": "common.defs.json#/$defs/control_id"
          },
          "necessity": {
            "type": "string",
            "enum": [
              "primary",
              "supporting",
              "optional"
            ]
          }
        },
        "required": [
          "control_id",
          "necessity"
        ],
        "additionalProperties": false
      }
    },
    "applicable_criteria": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/criterion_id"
      },
      "uniqueItems": true
    },
    "collection_frequency": {
      "$ref": "common.defs.json#/$defs/frequency"
    },
    "owner": {
      "type": "string",
      "description": "Typical accountable role."
    },
    "source_system_examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Illustrative systems that produce this artifact. Not an endorsement or an exhaustive list."
    },
    "freshness_expectation": {
      "type": "object",
      "description": "DriftGuard default, derived from control frequency. Tier 5 opinion, not an audit rule.",
      "properties": {
        "max_age_days": {
          "type": "integer",
          "minimum": 1
        },
        "basis": {
          "type": "string",
          "enum": [
            "control_frequency",
            "period_bound",
            "event_bound"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "max_age_days",
        "basis"
      ],
      "additionalProperties": false
    },
    "sensitivity": {
      "$ref": "common.defs.json#/$defs/sensitivity"
    },
    "redaction_guidance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention_guidance": {
      "type": "string"
    },
    "validation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^VR-[0-9]{3}$"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "existence",
              "relevance",
              "completeness",
              "timeliness",
              "authenticity",
              "sufficiency"
            ],
            "description": "The six evidence-analysis dimensions from framework/evidence_strategy.md."
          },
          "rule": {
            "type": "string"
          },
          "check_type": {
            "type": "string",
            "enum": [
              "deterministic",
              "heuristic",
              "llm_assisted",
              "human_review"
            ]
          },
          "failure_severity": {
            "$ref": "common.defs.json#/$defs/severity"
          },
          "failure_finding": {
            "$ref": "common.defs.json#/$defs/finding_id"
          }
        },
        "required": [
          "rule_id",
          "dimension",
          "rule",
          "check_type",
          "failure_severity"
        ],
        "additionalProperties": false
      }
    },
    "common_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "related_finding": {
            "$ref": "common.defs.json#/$defs/finding_id"
          }
        },
        "required": [
          "issue",
          "impact"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "$ref": "common.defs.json#/$defs/source_id_list"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/source_ref"
      }
    },
    "authority_tier_dominant": {
      "$ref": "common.defs.json#/$defs/authority_tier"
    },
    "verification_status": {
      "$ref": "common.defs.json#/$defs/verification_status"
    },
    "version": {
      "$ref": "common.defs.json#/$defs/semver"
    },
    "schema_version": {
      "$ref": "common.defs.json#/$defs/semver"
    },
    "status": {
      "$ref": "common.defs.json#/$defs/record_status"
    },
    "created": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "last_reviewed": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "superseded_by": {
      "$ref": "common.defs.json#/$defs/evidence_id"
    },
    "notes": {
      "$ref": "common.defs.json#/$defs/notes"
    }
  },
  "required": [
    "record_type",
    "evidence_id",
    "name",
    "description",
    "evidence_type",
    "evidence_role",
    "origin",
    "collection_mode",
    "persuasiveness_tier",
    "period_coverage",
    "expected_content",
    "applicable_controls",
    "collection_frequency",
    "owner",
    "freshness_expectation",
    "sensitivity",
    "validation_rules",
    "sources",
    "authority_tier_dominant",
    "verification_status",
    "version",
    "schema_version",
    "status",
    "created",
    "last_reviewed"
  ],
  "additionalProperties": false,
  "x-driftguard-schema-version": "0.2.0"
}
