{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftguard.io/schemas/soc2/source.schema.json",
  "title": "DriftGuard SOC 2 Source Registry",
  "description": "Governs framework/references.json: the single registry of citable sources and the authority-tier model.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "source_registry"
    },
    "registry_id": {
      "type": "string"
    },
    "version": {
      "$ref": "common.defs.json#/$defs/semver"
    },
    "last_reviewed": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "description": {
      "type": "string"
    },
    "authority_tiers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "tier": {
            "$ref": "common.defs.json#/$defs/authority_tier"
          },
          "key": {
            "type": "string",
            "enum": [
              "authoritative_requirement",
              "official_guidance",
              "industry_guidance",
              "auditor_interpretation",
              "driftguard_best_practice"
            ]
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "citation_obligation": {
            "type": "string"
          }
        },
        "required": [
          "tier",
          "key",
          "name",
          "definition",
          "citation_obligation"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "$ref": "common.defs.json#/$defs/source_id"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "authority_tier": {
            "$ref": "common.defs.json#/$defs/authority_tier"
          },
          "authority_key": {
            "type": "string",
            "enum": [
              "authoritative_requirement",
              "official_guidance",
              "industry_guidance",
              "auditor_interpretation",
              "driftguard_best_practice"
            ]
          },
          "edition": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "citation_hint": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "verification_status": {
            "$ref": "common.defs.json#/$defs/verification_status"
          },
          "verified_on": {
            "$ref": "common.defs.json#/$defs/date"
          }
        },
        "required": [
          "source_id",
          "title",
          "publisher",
          "authority_tier",
          "authority_key",
          "verification_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "record_type",
    "registry_id",
    "version",
    "authority_tiers",
    "sources"
  ],
  "additionalProperties": false,
  "x-driftguard-schema-version": "0.1.0"
}
