{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftguard.io/schemas/soc2/policy.schema.json",
  "title": "DriftGuard SOC 2 Policy Definition",
  "description": "Defines a policy document type and the elements DriftGuard expects it to contain. SOC 2 does not prescribe a policy list; required_elements are DriftGuard's model of what a policy must cover to support the controls that reference it.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "record_type": {
      "const": "policy"
    },
    "policy_id": {
      "$ref": "common.defs.json#/$defs/policy_id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "policy",
        "standard",
        "procedure",
        "plan",
        "register"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "scope_guidance": {
      "type": "string",
      "description": "Who and what the document should cover."
    },
    "supported_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.defs.json#/$defs/control_id"
      },
      "uniqueItems": true
    },
    "supported_criteria": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/criterion_id"
      },
      "uniqueItems": true
    },
    "required_elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^PE-[0-9]{3}$"
          },
          "element": {
            "type": "string"
          },
          "necessity": {
            "type": "string",
            "enum": [
              "expected",
              "recommended",
              "optional"
            ],
            "description": "'expected' means DriftGuard expects it, not that SOC 2 requires it."
          },
          "rationale": {
            "type": "string"
          },
          "sources": {
            "$ref": "common.defs.json#/$defs/source_id_list"
          }
        },
        "required": [
          "element_id",
          "element",
          "necessity",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "approval_expectation": {
      "type": "object",
      "properties": {
        "approver_role": {
          "type": "string"
        },
        "review_frequency": {
          "$ref": "common.defs.json#/$defs/frequency"
        },
        "evidence_of_approval": {
          "type": "array",
          "items": {
            "$ref": "common.defs.json#/$defs/evidence_id"
          }
        }
      },
      "additionalProperties": false
    },
    "communication_expectation": {
      "type": "string",
      "description": "How the policy should reach its audience; relevant to CC2 communication criteria."
    },
    "common_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_policies": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/policy_id"
      },
      "uniqueItems": true
    },
    "evidence_examples": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/evidence_id"
      },
      "uniqueItems": true
    },
    "common_findings": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/finding_id"
      },
      "uniqueItems": true
    },
    "sources": {
      "$ref": "common.defs.json#/$defs/source_id_list"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.defs.json#/$defs/source_ref"
      }
    },
    "authority_tier_dominant": {
      "$ref": "common.defs.json#/$defs/authority_tier"
    },
    "verification_status": {
      "$ref": "common.defs.json#/$defs/verification_status"
    },
    "version": {
      "$ref": "common.defs.json#/$defs/semver"
    },
    "schema_version": {
      "$ref": "common.defs.json#/$defs/semver"
    },
    "status": {
      "$ref": "common.defs.json#/$defs/record_status"
    },
    "created": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "last_reviewed": {
      "$ref": "common.defs.json#/$defs/date"
    },
    "superseded_by": {
      "$ref": "common.defs.json#/$defs/policy_id"
    },
    "notes": {
      "$ref": "common.defs.json#/$defs/notes"
    }
  },
  "required": [
    "record_type",
    "policy_id",
    "name",
    "description",
    "policy_type",
    "purpose",
    "supported_controls",
    "required_elements",
    "sources",
    "authority_tier_dominant",
    "verification_status",
    "version",
    "schema_version",
    "status",
    "created",
    "last_reviewed"
  ],
  "additionalProperties": false,
  "x-driftguard-schema-version": "0.1.0"
}
