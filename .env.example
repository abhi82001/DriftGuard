# DriftGuard infrastructure selection. Copy to your own environment; never commit real secrets.
DRIFTGUARD_ENV=development
DRIFTGUARD_REQUIRE_AUTH=1

# Storage adapter. SQLite is built in. Future adapters register the same contract.
DRIFTGUARD_STORAGE_PROVIDER=sqlite
DRIFTGUARD_DATABASE_URL=sqlite:///backend/driftguard.db

# Secret adapter. Values below are references/names, not secret values.
DRIFTGUARD_SECRET_PROVIDER=env

# AI (optional): ONE configuration for semantic evaluation, fact extraction and mapping assistance.
# Without a provider, model and key the app runs rules-only. The model must be in ai_models.json.
DRIFTGUARD_AI_PROVIDER=disabled
# DRIFTGUARD_AI_PROVIDER=anthropic   # or openai / openrouter
# DRIFTGUARD_AI_MODEL=<model id>
# ANTHROPIC_API_KEY=<set in shell/secret manager, not this file>
# OPENAI_API_KEY=<set in shell/secret manager, not this file>
# OPENROUTER_API_KEY=<set in shell/secret manager, not this file>
# DRIFTGUARD_AI_SEMANTIC_TOKEN_CAP=500000   # per-document budget for semantic evaluation/extraction
# DEPRECATED (one release; the DRIFTGUARD_AI_* names win): DRIFTGUARD_SEMANTIC_PROVIDER=claude,
# DRIFTGUARD_CLAUDE_MODEL, DRIFTGUARD_SEMANTIC_TIMEOUT_SECONDS, DRIFTGUARD_SEMANTIC_MAX_RETRIES

# Existing API-key boundary; set the actual value in your environment/secret manager.
# DRIFTGUARD_API_KEY=<secret>
